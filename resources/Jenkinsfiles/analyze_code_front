def stringVariable = ""
def stringSonar = ""
def skipRemainingStages = false

pipeline {
    agent any

    stages {
        stage('Descargar repositorios') {
            steps {
                script {
					sh 'echo Descargando repositorios de git'
                
                    def repos = ['ritsfront']
        
                    for (repo in repos) {
                        dir(repo) {
                            git(
                                url: "ssh://git@192.168.88.194:3004/~/${repo}.git",
                                branch: 'master',
                                changelog: true,
                                poll: true
                            )
                        }
                    }
                }
            }
        }
        
        stage('Loggear últimos commit') {
            steps {
                script {
					sh 'echo Obteniendo información de los cambios desde la última ejecución'
				
					def changeLogSets = currentBuild.changeSets

                    if (changeLogSets.size() == 0) {
                        echo "No ha habido cambios en el repositorio. No es necesario analizar el código."
                        skipRemainingStages = true
                    }
                    
                	echo "El número de commits desde la última ejecución ha sido: " + changeLogSets.size();

					for (int i = 0; i < changeLogSets.size(); i++) {
						def entries = changeLogSets[i].items
						
						for (int j = 0; j < entries.length; j++) {
							def entry = entries[j]
							
							echo "${entry.commitId} by ${entry.author} on ${new Date(entry.timestamp)}: ${entry.msg}"
							
							stringVariable += '<div style="background-color: #f0f0f0; padding: 10px;">'
							stringVariable += "<strong>Commit: ${entry.commitId}</strong><br/>"
							stringVariable += "Commit message: ${entry.msg}<br/>"
							stringVariable += "Autor: ${entry.author}<br/>"
							stringVariable += "Fecha: ${new Date(entry.timestamp)}<br/><br/>"
							
							def files = new ArrayList(entry.affectedFiles)
							
							stringVariable += "Ficheros afectados:<br/>"
							for (int k = 0; k < files.size(); k++) {
							
								def file = files[k]
								                        
								stringVariable += " - ${file.editType.name} ${file.path}<br/>"
							}
							
							stringVariable += "</div><br/>"
						}
					}
				}
            }
        }
        
        stage('Sonarfront') {
            when {
                expression {
                    !skipRemainingStages
                }
            }
            
            steps {
                script {
                
					sh 'echo Compilando front'
                    dir("ritsback/_ritsfront") {
                       withSonarQubeEnv('sonarqube') { 
                        	sh 'mvn sonar:sonar -Dsonar.projectName=ritsfront_master -Dsonar.projectKey=ritsfront_master'
                       }
                    }
                }
            }
        }
        
        stage("Quality Gate") {
            when {
                expression {
                    !skipRemainingStages
                }
            }
            
            steps {
                script {
                    
            		def response = sh(script: 
            		'''#!/bin/bash
            		
            		sleep 60
            		
            		SONARQUBE_URL="http://192.168.88.195:9000"
    				SONARQUBE_PROJECT_KEY="ritsfront_master"
    				SONARQUBE_TOKEN="sqa_5b5b6a8e918ba033d74479f9a64a6d0816d23efb"
    				
    				STATUS=$(curl -s -u ${SONARQUBE_TOKEN}: "${SONARQUBE_URL}/api/qualitygates/project_status?projectKey=${SONARQUBE_PROJECT_KEY}" | jq -r '.projectStatus.status')
                    CONDITIONS=$(curl -s -u ${SONARQUBE_TOKEN}: "${SONARQUBE_URL}/api/qualitygates/project_status?projectKey=${SONARQUBE_PROJECT_KEY}" | jq -r '.projectStatus.conditions')
                    
                    if [ "$STATUS" = "ERROR" ]; then
                        metrics=$(echo "$CONDITIONS" | jq -c '.[]')
                        
                        while IFS= read -r metric; do
                              CONDITIONS=$(echo "$metric" | jq -r '.status')
                        
                              if [ "$CONDITIONS" = "ERROR" ]; then
                                 METRIC=$(echo "$metric" | jq -r '.metricKey')
                                 MAX=$(echo "$metric" | jq -r '.errorThreshold')
                                 NOW=$(echo "$metric" | jq -r '.actualValue')
                        
                                 stringSonar+='<div style="background-color: #f0f0f0; padding: 10px;">'
                                 stringSonar+="<strong>METRICA CON ERROR: "
                                 stringSonar+="$(echo -e "$METRIC")"
                                 stringSonar+="</strong><br/>"
                                 stringSonar+=" Umbral permitido: "
                                 stringSonar+="$(echo -e "$MAX")"
                                 stringSonar+="<br/>"
                                 stringSonar+=" Valor actual: "
                                 stringSonar+="$(echo -e "$NOW")"
                                 stringSonar+="<br/>"
                              fi
                        done <<< "$metrics"
                        stringSonar+="</div><br/>"
                    fi
                    
                    echo -e $stringSonar
                    ''', returnStdout: true);
                    
                    stringSonar = response;
                }
            }
        }
    }

    post {
        always {
            script {
                if (currentBuild.currentResult == 'FAILURE') {
                    stringVariable += "<br/>Información de logs para identificación de error:<br/>"
                    def logs = currentBuild.rawBuild.getLog(1000)
                    logs.each { log ->
                        stringVariable += " * ${log}<br/>"
                    }
                }
                
                if (skipRemainingStages){
                    // Enviar correo con los detalles
                    emailext subject: "${JOB_NAME} - Build #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                            body: """
                            <html>
                                <body>
                                    <h2>NO HA HABIDO CAMBIOS EN EL CÓDIGO DESDE EL ÚLTIMO ANÁLISIS. NO SE REALIZA COMPROBACIÓN EN SONAR NI LA COMPILACIÓN DEL CÓDIGO</h2>
                                    <p>Job: ${JOB_NAME}</p>
                                    <p>Número de Ejecución: ${BUILD_NUMBER}</p>
                                    <p>Estado de la Ejecución: ${currentBuild.currentResult}</p>
                                </body>
                            </html>
                            """,
                            to: 'jenkins.openits@gmail.com',
                            mimeType: 'text/html'
                }else if (!"${stringSonar}".equals("")) {
                    // Enviar correo con los detalles
                    emailext subject: "${JOB_NAME} - Build #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                            body: """
                            <html>
                                <body>
                                    <h2>RESULTADO DE COMPILACIÓN TRAS CAMBIOS EN EL CÓDIGO</h2>
                                    <p>Job: ${JOB_NAME}</p>
                                    <p>Número de Ejecución: ${BUILD_NUMBER}</p>
                                    <p>Estado de la Ejecución: ${currentBuild.currentResult}</p>
                                    
                                    <h2>Métricas de sonar incumplidas</h2> 
                                    <p>${stringSonar}</p>
                                
                                    <h2>Información de los Commits</h2>
                                    <p>Detalles de Cambios en la Última Ejecución:</p>
                                    <p>${stringVariable}</p>
                                </body>
                            </html>
                            """,
                            to: 'jenkins.openits@gmail.com',
                            mimeType: 'text/html'
                }else{
                    // Enviar correo con los detalles
                    emailext subject: "${JOB_NAME} - Build #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                            body: """
                            <html>
                                <body>
                                    <h2>RESULTADO DE COMPILACIÓN TRAS CAMBIOS EN EL CÓDIGO</h2>
                                    <p>Job: ${JOB_NAME}</p>
                                    <p>Número de Ejecución: ${BUILD_NUMBER}</p>
                                    <p>Estado de la Ejecución: ${currentBuild.currentResult}</p>
                                    
                                    <h2>Información de los Commits</h2>
                                    <p>Detalles de Cambios en la Última Ejecución:</p>
                                    <p>${stringVariable}</p>
                                </body>
                            </html>
                            """,
                            to: 'jenkins.openits@gmail.com',
                            mimeType: 'text/html'    
                }
            }
        }
    }
}