<?xml version="1.0" encoding="utf-8"?>
<p:citilog_config_v1 name="" version=""
	xmlns:p="citilog_config_v1"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="citilog_config_v1 ../../../adapter-lib/src/main/resources/schemas/citilog/citilog_config_v1.xsd ">
  <p:camera_uid element_type_id="2" element_type_param_id="1004" param_type_id="1" />
  <p:camera_alarms>
  	<!-- Vehículo lento -->
    <p:camera_alarm alarm="SlowVeh" lane_id="1" alarm_config_id="10002" />
    <p:camera_alarm alarm="SlowVeh" lane_id="2" alarm_config_id="20002" />
    <p:camera_alarm alarm="SlowVeh" lane_id="3" alarm_config_id="30002" />
    <!-- Parada en fluido -->
    <p:camera_alarm alarm="StopF" lane_id="1" alarm_config_id="40002" />
    <p:camera_alarm alarm="StopF" lane_id="2" alarm_config_id="50002" />
    <p:camera_alarm alarm="StopF" lane_id="3" alarm_config_id="60002" />
    <!-- Escombro -->
    <p:camera_alarm alarm="Debris" lane_id="1" alarm_config_id="70002" />
    <p:camera_alarm alarm="Debris" lane_id="2" alarm_config_id="80002" />
    <p:camera_alarm alarm="Debris" lane_id="3" alarm_config_id="90002" />
    <!-- Peatón -->
    <p:camera_alarm alarm="Pedestrian" lane_id="1" alarm_config_id="100002" />
    <p:camera_alarm alarm="Pedestrian" lane_id="2" alarm_config_id="110002" />
    <p:camera_alarm alarm="Pedestrian" lane_id="3" alarm_config_id="120002" />
    <!-- Visibilidad -->
    <p:camera_alarm alarm="Visibility" lane_id="1" alarm_config_id="130002" />
    <p:camera_alarm alarm="Visibility" lane_id="2" alarm_config_id="140002" />
    <p:camera_alarm alarm="Visibility" lane_id="3" alarm_config_id="150002" />
    <!-- Ralentización -->
    <p:camera_alarm alarm="SlowDown" lane_id="1" alarm_config_id="160002" />
    <p:camera_alarm alarm="SlowDown" lane_id="2" alarm_config_id="170002" />
    <p:camera_alarm alarm="SlowDown" lane_id="3" alarm_config_id="180002" />
    <!-- Contrasentido -->
    <p:camera_alarm alarm="WrongWay" lane_id="1" alarm_config_id="190002" />
    <p:camera_alarm alarm="WrongWay" lane_id="2" alarm_config_id="200002" />
    <p:camera_alarm alarm="WrongWay" lane_id="3" alarm_config_id="210002" />
  </p:camera_alarms>
  <p:dai_uid element_type_id="52" element_type_param_id="1004" param_type_id="1" />
  <p:dai_alarms>
    <p:dai_alarm type="Analyzer" state="CommError" alarm_config_id="10052" />
  </p:dai_alarms>
  <p:dai_states>
    <p:dai_state type="Analyzer" state="OK" element_state_id="1" />
    <p:dai_state type="Analyzer" state="NOK" element_state_id="1" />
    <p:dai_state type="Analyzer" state="CommError" element_state_id="1" />
    <p:dai_state type="Analyzer" state="VideoError" element_state_id="1" />
  </p:dai_states>
  <p:requests>
  	<p:request type="alarms"><![CDATA[<CitiCommand Id="3" Type="ListAlarm"><ListAlarm Filter="AlarmesEnCours"/></CitiCommand>]]></p:request>
  	<p:request type="devices"><![CDATA[<CitiCommand Id="34" Type="GetDevice"> <GetDevice Type="Analyzer" Address="ALL" State="ALL" Channel="ALL"/> </CitiCommand>]]></p:request>
  	<p:request type="keepAlive"><![CDATA[<CitiEvent Type="LIFESIG"><LIFESIG PeriodSec="30" TimeOutSec="60" /></CitiEvent>]]></p:request>
  </p:requests>
</p:citilog_config_v1>
