package com.revenga.rits.front.openitsdao.model.backup;

import java.io.Serializable;
import javax.persistence.*;


/**
 * The persistent class for the grid_field_group_operations database table.
 * 
 */
@Entity
@Table(name="grid_field_group_operations")
@NamedQuery(name="GridFieldGroupOperation.findAll", query="SELECT g FROM GridFieldGroupOperation g")
public class GridFieldGroupOperation implements Serializable {
	private static final long serialVersionUID = 1L;

	@Id
	@GeneratedValue(strategy=GenerationType.AUTO)
	private Integer id;

	private String description;

	private String name;

	public GridFieldGroupOperation() {
	}

	public Integer getId() {
		return this.id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getDescription() {
		return this.description;
	}

	public void setDescription(String description) {
		this.description = description;
	}

	public String getName() {
		return this.name;
	}

	public void setName(String name) {
		this.name = name;
	}

}