package com.revenga.rits.front.openitsdao.model.backup;

import java.io.Serializable;
import javax.persistence.*;

import com.fasterxml.jackson.annotation.JsonIgnore;


/**
 * The persistent class for the module_values database table.
 * 
 */
@Entity
@Table(name="module_values")
@NamedQuery(name="ModuleValue.findAll", query="SELECT m FROM ModuleValue m")
public class ModuleValue implements Serializable {
	private static final long serialVersionUID = 1L;

	@Id
	@GeneratedValue(strategy=GenerationType.AUTO)
	private Integer id;

	private String value;

	//uni-directional many-to-one association to ModuleParam
	@ManyToOne
	@JoinColumn(name="module_param_id")
	private ModuleParam moduleParam;

	//bi-directional many-to-one association to Module
	@JsonIgnore
	@ManyToOne
	private Module module;

	public ModuleValue() {
	}

	public Integer getId() {
		return this.id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getValue() {
		return this.value;
	}

	public void setValue(String value) {
		this.value = value;
	}

	public ModuleParam getModuleParam() {
		return this.moduleParam;
	}

	public void setModuleParam(ModuleParam moduleParam) {
		this.moduleParam = moduleParam;
	}

	public Module getModule() {
		return this.module;
	}

	public void setModule(Module module) {
		this.module = module;
	}

}
