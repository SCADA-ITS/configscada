package com.revenga.rits.front.openitsdao.model.backup;

import java.io.Serializable;
import javax.persistence.*;


/**
 * The persistent class for the vo_entity_field_enum_values database table.
 * 
 */
@Entity
@Table(name="vo_entity_field_enum_values")
@NamedQuery(name="VoEntityFieldEnumValue.findAll", query="SELECT v FROM VoEntityFieldEnumValue v")
public class VoEntityFieldEnumValue implements Serializable {
	private static final long serialVersionUID = 1L;

	@Id
	@GeneratedValue(strategy=GenerationType.AUTO)
	private Integer id;

	//bi-directional many-to-one association to VoEntity
	@ManyToOne
	@JoinColumn(name="vo_entity_id")
	private VoEntity voEntity;

	//uni-directional many-to-one association to VoEntityField
	@ManyToOne
	@JoinColumn(name="vo_entity_field_id")
	private VoEntityField voEntityField;

	//uni-directional many-to-one association to VoEnumTypeValue
	@ManyToOne
	@JoinColumn(name="vo_enum_type_value_id")
	private VoEnumTypeValue voEnumTypeValue;

	public VoEntityFieldEnumValue() {
	}

	public Integer getId() {
		return this.id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public VoEntity getVoEntity() {
		return this.voEntity;
	}

	public void setVoEntity(VoEntity voEntity) {
		this.voEntity = voEntity;
	}

	public VoEntityField getVoEntityField() {
		return this.voEntityField;
	}

	public void setVoEntityField(VoEntityField voEntityField) {
		this.voEntityField = voEntityField;
	}

	public VoEnumTypeValue getVoEnumTypeValue() {
		return this.voEnumTypeValue;
	}

	public void setVoEnumTypeValue(VoEnumTypeValue voEnumTypeValue) {
		this.voEnumTypeValue = voEnumTypeValue;
	}

}