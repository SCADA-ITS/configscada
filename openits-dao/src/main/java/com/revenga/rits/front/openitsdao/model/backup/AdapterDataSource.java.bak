package com.revenga.rits.front.openitsdao.model.backup;

import java.io.Serializable;
import javax.persistence.*;

import com.fasterxml.jackson.annotation.JsonIgnore;


/**
 * The persistent class for the adapter_data_sources database table.
 * 
 */
@Entity
@Table(name="adapter_data_sources")
@NamedQuery(name="AdapterDataSource.findAll", query="SELECT a FROM AdapterDataSource a")
public class AdapterDataSource implements Serializable {
	private static final long serialVersionUID = 1L;

	@Id
	@GeneratedValue(strategy=GenerationType.AUTO)
	private Integer id;

	private String value;

	//uni-directional many-to-one association to AdapterDataSourceType
	@ManyToOne
	@JoinColumn(name="adapter_data_source_type_id")
	private AdapterDataSourceType adapterDataSourceType;

	//bi-directional many-to-one association to Adapter
	@JsonIgnore
	@ManyToOne
	private Adapter adapter;

	//uni-directional many-to-one association to DataSource
	@ManyToOne
	@JoinColumn(name="data_source_id")
	private DataSource dataSource;

	public AdapterDataSource() {
	}

	public Integer getId() {
		return this.id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getValue() {
		return this.value;
	}

	public void setValue(String value) {
		this.value = value;
	}

	public AdapterDataSourceType getAdapterDataSourceType() {
		return this.adapterDataSourceType;
	}

	public void setAdapterDataSourceType(AdapterDataSourceType adapterDataSourceType) {
		this.adapterDataSourceType = adapterDataSourceType;
	}

	public Adapter getAdapter() {
		return this.adapter;
	}

	public void setAdapter(Adapter adapter) {
		this.adapter = adapter;
	}

	public DataSource getDataSource() {
		return this.dataSource;
	}

	public void setDataSource(DataSource dataSource) {
		this.dataSource = dataSource;
	}

}