package com.revenga.rits.front.openitsdao.model.backup;

import java.io.Serializable;
import javax.persistence.*;

import com.fasterxml.jackson.annotation.JsonIgnore;


/**
 * The persistent class for the tree_option_values database table.
 * 
 */
@Entity
@Table(name="tree_option_values")
@NamedQuery(name="TreeOptionValue.findAll", query="SELECT g FROM TreeOptionValue g")
public class TreeOptionValue implements Serializable {
	private static final long serialVersionUID = 1L;

	@Id
	@GeneratedValue(strategy=GenerationType.AUTO)
	private Integer id;

	private String value;

	//uni-directional many-to-one association to TreeOption
	@ManyToOne
	@JoinColumn(name="tree_option_id")
	private TreeOption treeOption;

	//bi-directional many-to-one association to Tree
	@JsonIgnore
	@ManyToOne
	private Tree tree;

	public TreeOptionValue() {
	}

	public Integer getId() {
		return this.id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getValue() {
		return this.value;
	}

	public void setValue(String value) {
		this.value = value;
	}

	public TreeOption getTreeOption() {
		return this.treeOption;
	}

	public void setTreeOption(TreeOption treeOption) {
		this.treeOption = treeOption;
	}

	public Tree getTree() {
		return this.tree;
	}

	public void setTree(Tree tree) {
		this.tree = tree;
	}

}