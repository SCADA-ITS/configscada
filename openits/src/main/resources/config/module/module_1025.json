{
	"restEndpoints": {
		"plan": "plans/${id}"
	},
	"topic": "/topic/plan",
	"adapters": {
		"orders": "ws.order.getList"
	},
	"confirmOrderTypes":[
		"PlanOrderType:2"
	],
	"planStateTransitions":{
		"PlanStateType:0" : ["PLAY"],
		"PlanStateType:1" : ["PLAY"],
		"PlanStateType:2" : ["PAUSE" , "STOP"],
		"PlanStateType:3" : ["PLAY"],
		"PlanStateType:4" : ["PLAY" , "STOP"],
		"PlanStateType:5" : ["PLAY" , "STOP"],
		"PlanStateType:6" : ["PLAY"]
	}, 
	"actionButtons": [
		{
			"action": "PLAY",
			"moduleAction": {
				"id" : 102302
			},
			"label" : "LBL_PLAY",
			"icon" : "mdi mdi-play",
			"css" : "planExecutor-button-play",
			"disabled" : false
		},
		{
			"action": "PAUSE",
			"moduleAction": {
				"id" : 102302
			},
			"label" : "LBL_PAUSE",
			"icon" : "mdi mdi-pause",
			"css" : "planExecutor-button-pause",
			"disabled" : true
		},
		{
			"action": "STOP",
			"moduleAction": {
				"id" : 102302
			},
			"label" : "LBL_STOP",
			"icon" : "mdi mdi-stop",
			"css" : "planExecutor-button-stop",
			"disabled" : true
		}
	]
}