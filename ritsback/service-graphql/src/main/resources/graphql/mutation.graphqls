type Mutation {

	#Element
	createElement(element: ElementVO!): ElementGraphql
	cloneElement(elementId: String!): ElementGraphql
	updateElement(element: ElementVO!): ElementGraphql
	deleteElement(elementId: String!): ElementGraphql
	sendCommandElement(commands: [CommandElementVO!]!): [CommandElementPreconditionGraphql!]!
	sendCommandElementSync(commands: [CommandElementVO!]!): [CommandElementErrorGraphql!]
	
	addCommandElement(commands: [PmCommandElementVO!]!): [CommandElementErrorGraphql!]
	deleteCommandElement(commandElementsId: [String!]!): [CommandElementErrorGraphql!]
	deleteCommandElementBySource(source: String!): [CommandElementErrorGraphql!]
	disablePriority(elementId: String!, priorityId: String!): [CommandElementErrorGraphql!]
	enablePriority(elementId: String!, priorityId: String!): [CommandElementErrorGraphql!]
	
	#Element State
	sendChangeElementState(elementStates: [ElementStateVO!]!): Boolean
	
	#Alarm
	createAlarmConfig(alarmConfig: AlarmConfigVO!): AlarmConfigGraphql
	updateAlarmConfig(alarmConfig: AlarmConfigVO!): AlarmConfigGraphql
	deleteAlarmConfig(alarmConfigId: String!): AlarmConfigGraphql
	
	sendAlarms(alarmConfigIds: [String!]!, targetElementIds: [String!]!, creationComments: String, userId: String!): Boolean
	sendRecognizeAlarms(alarmIds: [String!], recognizedComments: String, userId: String, disagree: Boolean): Boolean
	sendDeactivationAlarms(alarmIds: [String!], deactivationComments: String, userId: String): Boolean
	
	sendAlarmFilteredActions(alarmFiltereds: [AlarmFilteredVO!]!): Boolean
	
	#User
	createUser(user: UserVO!): UserGraphql
	updateUser(user: UserVO!): UserGraphql
	deleteUser(userId: String!): UserGraphql
	
	createRole(role: RoleVO!): RoleGraphql
	updateRole(role: RoleVO!): RoleGraphql
	deleteRole(roleId: String!): RoleGraphql
	
	sendKillUser(userIds: [String!]!, lockedTimeS: Int!): Boolean
	
	#Plan
	createPlan(plan: PlanVO!): PlanGraphql
	updatePlan(plan: PlanVO!): PlanGraphql
	deletePlan(planId: String!): PlanGraphql
	
	createPlanOrder(planOrder: PlanOrderVO!): PlanOrderGraphql
	updatePlanOrder(planOrder: PlanOrderVO!): PlanOrderGraphql
	deletePlanOrder(planOrderId: String!): PlanOrderGraphql
	
	#createPlanSchedules(planSchedules: PlanSchedulesVO!): PlanScheduleGraphql
	#updatePlanSchedules(planSchedules: PlanSchedulesVO!): PlanScheduleGraphql
	#deletePlanSchedules(planSchedulesId: String!): PlanScheduleGraphql
	
	createPlanNode(planNode: PlanNodeVO!): PlanNodeGraphql
	deletePlanNode(planNodeId: String!): PlanNodeGraphql
	
	sendPlayPlan(planIds: [String!]!): Boolean
	sendPlanActions(planActions: [PlanActionVO!]!): Boolean
	sendPlanScheduleActions(planSchedules: [PlanSchedulesVO!]!): [PlanScheduleGraphql!]
	
    #Incident
    createIncidentReport(incidentTypeId: String!, locationId: String!, alarmIds: [String!], affectionStretchIds: [String!], userId: String, roadImpactId: String): Boolean    
    changeIncidentReport(incidentReportId: String!, locationId: String!, affectionStretchId: String!, incidentTypeId: String!, roadImpactId: String): Boolean  
    
    confirmIncidentReport(incidentReportId: String!, userId: String): Boolean
    forwardIncidentReport(incidentReportId: String!): Boolean
    backwardIncidentReport(incidentReportId: String!): Boolean
    cancelIncidentReport(incidentReportId: String!, userId: String): Boolean
    changeRoadImpactIncidentReport(incidentReportId: String!, roadImpactId: String): Boolean
    
    assignUserIncidentReport(incidentReportId: String!, userId: String!): Boolean
    assignCauseIncidentReport(incidentReportId: String!, incidentTypeCauseId: String!): Boolean 
    	
	assignIncidentParamValues(incidentParamValues: [ImsIncidentReportParamValueVO!]!): Boolean
    
    finalizeTaskIncidentReport(incidentReportId: String!, incidentTypeTaskId: String!, incidentTypeTaskValues: [ImsIncidentTypeTaskValueVO!]): Boolean
    executeTaskPlanIncidentReport(incidentReportId: String!, incidentTaskPlanId: String!): Boolean
	addLogIncidentReport(incidentReportLogs: [ImsIncidentReportLogVO!]!): Boolean
    deleteLogIncidentReport(incidentReportLogId: String!): Boolean
   
   	#Incidents Conf 
	createImsIncidentType(imsIncidentType: ImsIncidentTypeVO!): ImsIncidentTypeGraphql
	updateImsIncidentType(imsIncidentType: ImsIncidentTypeVO!): ImsIncidentTypeGraphql
	deleteImsIncidentType(imsIncidentTypeId: String!): ImsIncidentTypeGraphql
	
	createImsIncidentTypeStretch(imsIncidentTypeStretch: ImsIncidentTypeStretchVO!): ImsIncidentTypeStretchGraphql
	updateImsIncidentTypeStretch(imsIncidentTypeStretch: ImsIncidentTypeStretchVO!): ImsIncidentTypeStretchGraphql
	deleteImsIncidentTypeStretch(imsIncidentTypeStretchId: String!): ImsIncidentTypeStretchGraphql
	
	createImsIncidentAlarmCondition(imsIncidentAlarmCondition: ImsIncidentAlarmConditionVO!): ImsIncidentAlarmConditionGraphql
	updateImsIncidentAlarmCondition(imsIncidentAlarmCondition: ImsIncidentAlarmConditionVO!): ImsIncidentAlarmConditionGraphql
	deleteImsIncidentAlarmCondition(imsIncidentAlarmConditionId: String!): ImsIncidentAlarmConditionGraphql
	
	createImsIncidentTypeTask(imsIncidentTypeTask: ImsIncidentTypeTaskVO!): ImsIncidentTypeTaskGraphql
	updateImsIncidentTypeTask(imsIncidentTypeTask: ImsIncidentTypeTaskVO!): ImsIncidentTypeTaskGraphql
	deleteImsIncidentTypeTask(imsIncidentTypeTaskId: String!): ImsIncidentTypeTaskGraphql
	
	createImsIncidentTaskPlan(imsIncidentTaskPlan: ImsIncidentTaskPlanVO!): ImsIncidentTaskPlanGraphql
	updateImsIncidentTaskPlan(imsIncidentTaskPlan: ImsIncidentTaskPlanVO!): ImsIncidentTaskPlanGraphql
	deleteImsIncidentTaskPlan(imsIncidentTaskPlanId: String!): ImsIncidentTaskPlanGraphql
	
	createImsIncidentTypeStateTransition(imsIncidentTypeStateTransition: ImsIncidentTypeStateTransitionVO!): ImsIncidentTypeStateTransitionGraphql
	updateImsIncidentTypeStateTransition(imsIncidentTypeStateTransition: ImsIncidentTypeStateTransitionVO!): ImsIncidentTypeStateTransitionGraphql
	deleteImsIncidentTypeStateTransition(imsIncidentTypeStateTransitionId: String!): ImsIncidentTypeStateTransitionGraphql
	
    sendCreateExIncident(extIncidents: [ImsExtIncidentVO!]!): [ImsExtIncidentGraphql!]
    sendUpdateExIncident(extIncidents: [ImsExtIncidentVO!]!): [ImsExtIncidentGraphql!]
    sendDeleteExIncident(extIncidentIds: [String!]!): [ImsExtIncidentGraphql!]
    
    #AuditLog
    sendAuditLogs(auditLogs: [AuditLogVO!]!): Boolean
    sendRecognizeAuditLogs(auditLogIds: [String!]): Boolean
    
    #Sm
    updateSmThresholds(smThresholds: [SmThresholdVO!]!): [SmThresholdGraphql!]
    
    #ProcessInfo
	stopProcesses(pids: [Int!]): Boolean
	
	#Location
	createLocation(location: LocationVO!): LocationGraphql
	updateLocation(location: LocationVO!): LocationGraphql
	deleteLocation(locationId: String!): LocationGraphql
}