type Query {
	#SystemParam
	getSystemParams(systemParamIds: [String!]):[SystemParamGraphql]
	
	#CCTVScenario
	getCCTVScenario(scenarioId: String!):CCTVScenarioGraphql
	getCCTVScenarios:[CCTVScenarioGraphql]
	getCCTVScenarioHierarchies:[CCTVScenarioHierarchyGraphql]

	
	# Element
	getElementHierarchies:[ElementHierarchyGraphql] 
	
	getElementTypes:[ElementTypeGraphql]
	getElementType(elementTypeId: String!):ElementTypeGraphql
	
	getElements(elementIds: [String!]):[ElementGraphql]
	getElement(elementId: String!):ElementGraphql
	getElementsByType(elementTypeId: String!):[ElementGraphql]
	getElementsByStretchs(stretchIds: [String!], elementTypeId: String):[ElementGraphql]
	
	getElementTypeStates(elementTypeId: String!):[ElementTypeStateGraphql]
	getElementValueStates:[ElementValueStateGraphql]
	
	getElementTrees(userId: String!):[ElementTreeGraphql]
	getElementTree(elementTreeId: String!):ElementTreeGraphql
	
	# Alarm

	getAlarms(alarmIds: [String!]):[AlarmGraphql]

		
	getAlarmConfigs:[AlarmConfigGraphql]
	getAlarmConfig(alarmConfigId: String!):AlarmConfigGraphql
	getAlarmConfigsByAlarmType(alarmTypeId: String!):[AlarmConfigGraphql]
	getAlarmConfigsByAlarmLevel(alarmLevelId: String!):[AlarmConfigGraphql]
	getAlarmConfigsByElementType(elementTypeId: String!):[AlarmConfigGraphql]
	
	getThresholdOperations:[ThresholdOperationGraphql]
	getThresholdOperation(thresholdOperationId: String!):ThresholdOperationGraphql
	
	getAlarmTypes:[AlarmTypeGraphql]
	getAlarmType(alarmTypeId: String!):AlarmTypeGraphql
	
	getAlarmLevels:[AlarmLevelGraphql]
	getAlarmLevel(alarmLevelId: String!):AlarmLevelGraphql
	
	getAlarmsByType(alarmTypeId: String):[AlarmGraphql]
	getAlarm(alarmId: String!):AlarmGraphql
	getAlarmsByAlarmConfig(alarmConfigId: String!):[AlarmGraphql]
	getAlarmsBySource(sourceElementId: String!, alarmTypeId: String):[AlarmGraphql]
	getAlarmsByTarget(targetElementId: String!, alarmTypeId: String):[AlarmGraphql]
		
	getAlarmFiltereds:[AlarmFilteredGraphql]
	getAlarmFiltered(alarmFilteredId: String!):AlarmFilteredGraphql
	getAlarmFilteredsByAlarmConfig(alarmConfigId: String!):[AlarmFilteredGraphql]
	getAlarmFilteredsByElement(elementId: String!):[AlarmFilteredGraphql]
	
	# User
	getUsers:[UserGraphql]
	getUser(userId: String!):UserGraphql
	
	getRoles:[RoleGraphql]
	getRole(roleId: String!):RoleGraphql
	
	getSystemPermissions:[SystemPermissionGraphql]
	getSystemPermission(systemPermissionId: String!):SystemPermissionGraphql
	
	# Plan
	getPlanHierarchies:[PlanHierarchyGraphql]
	getPlanNodes:[PlanNodeGraphql]
	
	getPlanOrders:[PlanOrderGraphql]
	getPlanOrder(planOrderId: String!):PlanOrderGraphql
	
	getPlanOrderTypes:[PlanOrderTypeGraphql]
	getPlanOrderType(planOrderTypeId: String!):PlanOrderTypeGraphql
	
	getPlans:[PlanGraphql]
	getPlan(planId: String!):PlanGraphql
	
	getPlanStateTypes:[PlanStateTypeGraphql]
	getPlanOrderStateTypes:[PlanOrderStateTypeGraphql]
	getPlanScheduleStateTypes:[PlanScheduleStateTypeGraphql]
	
	getPlanSchedules:[PlanScheduleGraphql]
	getPlanSchedule(planScheduleId: String!):PlanScheduleGraphql
	getPlanScheduleByPlan(planId: String!):[PlanScheduleGraphql]
	
	# GenericData
	getGenericDatas:[GenericDataGraphql]
	getGenericData(genericDataId: String!):GenericDataGraphql
	
	# Location
	getRoads:[RoadGraphql]
	getRoad(roadId: String!):RoadGraphql
	
	getStretchs:[StretchGraphql]
	getStretch(stretchId: String!):StretchGraphql
	getStretchStretchsByStretch(stretchId: String!):[StretchStretchGraphql]
	getStretchByRoad(roadId: String!):[StretchGraphql]
	getStretchByLocation(locationId: String!):[StretchGraphql]
	
	getLocations:[LocationGraphql]
	getLocation(locationId: String!):LocationGraphql
	getLocationsByStretch(stretchId: String!):[LocationGraphql]
	getLocationsByStretchs(stretchIds: [String!]):[LocationGraphql]
	
	getSpaths(spathIds: [String!], stretchId: String): [SpathGraphql]
	
	# Incident
	
	getImsIncidentGroups:[ImsIncidentGroupGraphql]
	getImsIncidentGroup(incidentGroupId: String!):ImsIncidentGroupGraphql

	getImsIncidentTypesByGroup(incidentGroupId: String!):[ImsIncidentTypeGraphql]	
	getImsIncidentTypes:[ImsIncidentTypeGraphql]
	
	getImsIncidentType(incidentTypeId: String!):ImsIncidentTypeGraphql
	
	getExtIncidents:[ImsExtIncidentGraphql]
	getExtIncident(extIncidentId: String!):ImsExtIncidentGraphql
	
	getExtIncidentTypes:[ImsExtIncidentTypeGraphql]
	getExtIncidentType(extIncidentTypeId: String!):ImsExtIncidentTypeGraphql
	
	getImsIncidentStates:[ImsIncidentStateGraphql]
	getImsIncidentState(imsIncidentStateId: String!):ImsIncidentStateGraphql
	
	getImsIncidentLevels:[ImsIncidentLevelGraphql]
	getImsIncidentLevel(imsIncidentLevelId: String!):ImsIncidentLevelGraphql
	
	getImsTaskTypes:[ImsTaskTypeGraphql]
	getImsTaskType(imsTaskTypeId: String!):ImsTaskTypeGraphql
	
	getImsIncidentReports:[ImsIncidentReportGraphql]
	getImsIncidentReport(imsIncidentReportId: String!):ImsIncidentReportGraphql
	
	getImsTaskPlans(stretchId: String!, incidentTypeId: String!, incidentTypeTaskId: String!):[ImsIncidentTaskPlanGraphql]
	getImsIncidentTypeTasks(incidentTypeId: String!, incidentStateId: String):[ImsIncidentTypeTaskGraphql]
	
	getAllImsTaskPlans:[ImsIncidentTaskPlanGraphql]
	getAllImsIncidentTypeTasks:[ImsIncidentTypeTaskGraphql]
	
	getImsIncidentAlarmConditionAlarmTypes:[ImsIncidentAlarmConditionAlarmTypeGraphql]
	getImsIncidentAlarmConditionAlarmType(imsIncidentAlarmConditionAlarmTypeId: String!):ImsIncidentAlarmConditionAlarmTypeGraphql
	
	getImsIncidentTypeStretchs:[ImsIncidentTypeStretchGraphql]
	getImsIncidentTypeStretchsByIncidentType(incidentTypeId: String!):[ImsIncidentTypeStretchGraphql]
	getImsIncidentTypeStretch(stretchId: String!, incidentTypeId: String!):ImsIncidentTypeStretchGraphql
	
	# Level of service
	getLevelOfServices:[LevelOfServiceGraphql]
	getLevelOfService(levelOfServicesId: String!):LevelOfServiceGraphql
	
	# Log
	getLogTypes:[LogTypeGraphql]
	getLogType(logTypeId: String!):LogTypeGraphql
	
	getAuditLogs:[AuditLogGraphql]
	getAuditLogsByType(logTypeId: String!):[AuditLogGraphql]
	getAuditLog(auditLogId: String!):AuditLogGraphql
	
	# i18n
	getLocales:[I18nLocaleGraphql]
	getLocale(localeId: String!):I18nLocaleGraphql
	getTranslations(localeId: String!, moduleId: Int):[I18nLabelGraphql]
	getTranslation(localeId: String!, moduleId: Int!, label: String!, fields:[String!]):I18nLabelGraphql
	
	# Server Info
	getProcessesInfo:[ProcessInfoGraphql!]
	getServerTime: Long
	
	# Resources
	getResources(relativePath: String!, extension: String!):[String]
	
	# Sm
	getSmThresholds(stateMachineId: String): [SmThresholdGraphql!]
	getSmStateMachines(smStateMachineIds: [String!]): [SmStateMachineGraphql]
	
}