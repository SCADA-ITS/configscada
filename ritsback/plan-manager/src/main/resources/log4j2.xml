<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
	<Properties>
		<Property name="LOG_PATTERN_CONSOLE">
			%highlight{[PLAN-MANAGER][%d{dd/MM/yyyy HH:mm:ss,SSS}][%-5p] - %m%n}
		</Property>
		<Property name="LOG_PATTERN_DEBUG">
			[%d{dd/MM/yyyy HH:mm:ss,SSS}][%30.30t][%-5p](%30.30F#%-4L) - %m%n
		</Property>
		<Property name="LOG_PATTERN_INFO">
			[%d{dd/MM/yyyy HH:mm:ss,SSS}][%-5p] - %m%n
		</Property>
	</Properties>
	<Appenders>
		<Console name="ConsoleAppender" target="SYSTEM_OUT"
			follow="true">
			<PatternLayout pattern="${LOG_PATTERN_CONSOLE}" />
		</Console>
		<RollingFile name="FileDebugAppender"
			fileName="${env:RITS_LOGS}/plan-manager/debug/plan-manager_debug.log"
			filePattern="${env:RITS_LOGS}/plan-manager/debug/plan-manager_debug.%i.log.gz"
			ignoreExceptions="false">

			<PatternLayout pattern="${LOG_PATTERN_DEBUG}" />
			<Policies>
				<SizeBasedTriggeringPolicy size="100MB" />
			</Policies>
			<DefaultRolloverStrategy max="10" />
		</RollingFile>
		<RollingFile name="FileInfoAppender"
			fileName="${env:RITS_LOGS}/plan-manager/plan-manager.log"
			filePattern="${env:RITS_LOGS}/plan-manager/plan-manager.%i.log"
			ignoreExceptions="false">

			<PatternLayout pattern="${LOG_PATTERN_INFO}" />
			<Policies>
				<SizeBasedTriggeringPolicy size="10000KB" />
			</Policies>
			<DefaultRolloverStrategy max="10" />

		</RollingFile>
	</Appenders>
	<Loggers>
        <Root>
        	<AppenderRef ref="ConsoleAppender" level="info"/>
        </Root>
        
        <!-- LOG "com.revenga.rits.back*" at TRACE level -->
        <Logger name="com.revenga.rits.back" level="trace" additivity="false">
        	<AppenderRef ref="ConsoleAppender" level="info"/>
            <AppenderRef ref="FileDebugAppender" level="debug"/>
            <AppenderRef ref="FileInfoAppender" level="info"/>
        </Logger>
	</Loggers>
</Configuration>