<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.revenga.rits.back</groupId>
	<artifactId>adapter-lib</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>adapter-lib</name>

	<properties>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>11</java.version>
		<maven.test.skip>true</maven.test.skip>
		<data-core-lib.version>0.0.1-SNAPSHOT</data-core-lib.version>
		<maven-compiler-plugin.version>3.8.1</maven-compiler-plugin.version>
		<jakarta.xml.bind-api.version>2.3.2</jakarta.xml.bind-api.version>
		<jaxb-runtime.version>2.3.2</jaxb-runtime.version>
		<commons-lang3.version>3.9</commons-lang3.version>
		<lombok.version>1.18.10</lombok.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
		</dependency>
		<dependency>
			<groupId>com.revenga.rits.back</groupId>
			<artifactId>data-core-lib</artifactId>
			<version>${data-core-lib.version}</version>
		</dependency>
		<!-- API, java.xml.bind module -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>${jakarta.xml.bind-api.version}</version><!--$NO-MVN-MAN-VER$ -->
		</dependency>

		<!-- Runtime, com.sun.xml.bind module -->
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>${jaxb-runtime.version}</version><!--$NO-MVN-MAN-VER$ -->
		</dependency>

		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>${commons-lang3.version}</version>
		</dependency>

	</dependencies>

	<build>
		<finalName>adapter-lib</finalName>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>jaxb2-maven-plugin</artifactId>
					<version>2.5.0</version>
					<executions>
						<execution>
							<id>xjc</id>
							<goals>
								<goal>xjc</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<!-- Generate an episode file from this compilation, so that other 
							schemas that rely on this schema can be compiled later and rely on classes 
							that are generated from this compilation. The generated episode file is really 
							just a JAXB customization file (but with vendor extensions.) -->
						<generateEpisode>false</generateEpisode>
						<!-- The package of your generated sources -->
						<packageName>com.revenga.rits.back.adapter.lib.model</packageName>
						<noGeneratedHeaderComments>true</noGeneratedHeaderComments>
						<sources>
							<source>src/main/resources/schemas/mango/json_generic_mango_v1.xsd</source>
							<source>src/main/resources/schemas/citilog/Citilog.xsd</source>
							<!-- <source>src/main/resources/schemas/citilog/Citilog-CitiAnswer.xsd</source> -->
							<!-- <source>src/main/resources/schemas/citilog/Citilog-CitiEvent.xsd</source> -->
							<source>src/main/resources/schemas/citilog/citilog_config_v1.xsd</source>
							<source>src/main/resources/schemas/rtms/rtms_config_v1.xsd</source>
							<source>src/main/resources/schemas/pub-stomp/pub_stomp_adapter_v1.xsd</source>
							<source>src/main/resources/schemas/manager/manager_adapter_v1.xsd</source>
							<source>src/main/resources/schemas/manager/historical_period_parser_v1.xsd</source>
							<source>src/main/resources/schemas/manager/historical_instant_parser_v1.xsd</source>
							<source>src/main/resources/schemas/manager/historical_instant_parser_v2.xsd</source>
							<source>src/main/resources/schemas/manager/historical_element_parser_v1.xsd</source>
							<source>src/main/resources/schemas/manager/historical_audit_log_parser_v1.xsd</source>
							<source>src/main/resources/schemas/controller/controller_adapter_v1.xsd</source>
							<source>src/main/resources/schemas/server-launcher/server_launcher_adapter_v1.xsd</source>
						</sources>
						<outputDirectory>${basedir}/src/main/java</outputDirectory>

						<clearOutputDir>false</clearOutputDir>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<source>${java.version}</source>
						<target>${java.version}</target>
						<forceJavacCompilerUse>true</forceJavacCompilerUse>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		
		<plugins>
			<plugin>
				<artifactId>exec-maven-plugin</artifactId>
				<groupId>org.codehaus.mojo</groupId>
				<executions>
					<execution>
						<!-- Run our version calculation script -->
						<id>Git commit version file generator</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>${basedir}/../_ritsback/scripts/gitversion.sh</executable>
							<workingDirectory>${basedir}</workingDirectory>
							<arguments>
            					<argument>${basedir}</argument>
            				</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
