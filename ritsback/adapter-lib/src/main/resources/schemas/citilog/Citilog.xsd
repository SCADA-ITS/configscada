<?xml version="1.0" encoding="utf-8"?>
<xs:schema
    attributeFormDefault="unqualified"
    elementFormDefault="qualified"
    xmlns:cmn="Citilog-CommonTypes"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">
    
  <xs:import schemaLocation="Citilog-CommonTypes.xsd" namespace="Citilog-CommonTypes" />
    
  <xs:element name="CitiAnswer">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Device" type="CL_Type_Device" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="Alarm" type="CL_Type_Alarm" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="Type" type="cmn:CL_Enum_CitiAnswerType" use="required" />
      <xs:attribute name="Id" type="xs:unsignedByte" use="required" />
    </xs:complexType>
  </xs:element>
  
   <xs:element name="CitiEvent">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Device" type="CL_Type_Device" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="Alarm" type="CL_Type_Alarm" minOccurs="0" maxOccurs="unbounded" />
        <xs:element name="LIFESIG" type="CL_Type_LIFESIG" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="Type" type="cmn:CL_EnumCitiEventType" use="required" />
    </xs:complexType>
  </xs:element>

  <xs:complexType name="CL_Type_Device">
    <xs:sequence>
	  <xs:element name="Name" type="xs:string" minOccurs="0" maxOccurs="1" />
      <xs:element name="Type" type="cmn:CL_Enum_DeviceType" minOccurs="0" maxOccurs="1" />
      <xs:element name="Address" type="xs:string" minOccurs="0" maxOccurs="1"/>
	  <xs:element name="State" type="cmn:CL_Enum_DeviceStateType" minOccurs="0" maxOccurs="1" />
	  <xs:element name="CameraName" type="xs:string" minOccurs="0" maxOccurs="1" />
	</xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="CL_Type_Alarm">
    <xs:sequence>
	  <xs:element name="Type" type="cmn:CL_Enum_AlarmType" minOccurs="0" maxOccurs="1" />
	  <xs:element name="CameraName" type="xs:string" minOccurs="0" maxOccurs="1" />
	  <xs:element name="CameraId" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" />
	  <xs:element name="LaneId" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" />
	  <xs:element name="StartTime" type="xs:string" minOccurs="0" maxOccurs="1" />
	  <xs:element name="EndTime" type="xs:string" minOccurs="0" maxOccurs="1" />
      <xs:element name="Comment" type="xs:string" minOccurs="0" maxOccurs="1" />
      <xs:element name="RowRatio" type="xs:byte" minOccurs="0" maxOccurs="1" />
      <xs:element name="ColumnRatio" type="xs:byte" minOccurs="0" maxOccurs="1" />
      <xs:element name="ExtraAlarmData" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Danger" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" />
            <xs:element name="Material" type="xs:unsignedShort" minOccurs="0" maxOccurs="1" />
            <xs:element name="Reliability" type="xs:byte" minOccurs="0" maxOccurs="1" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
	</xs:sequence>
    <xs:attribute name="Id" type="xs:unsignedByte" use="required" />
  </xs:complexType>
  
  <xs:complexType name="CL_Type_LIFESIG">
    <xs:attribute name="PeriodSec" type="xs:unsignedByte" use="required" />
    <xs:attribute name="TimeOutSec" type="xs:unsignedByte" use="required" />
  </xs:complexType>
  
</xs:schema>