<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  xmlns:cmn="Citilog-CommonTypes"
  xmlns="Citilog-CommonTypes"
  targetNamespace="Citilog-CommonTypes"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
 
  <!-- CitiEvent list - indicates the type of CitiEvent -->
  <xs:simpleType name="CL_EnumCitiEventType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Alarm" />
      <xs:enumeration value="Device" />
	  <xs:enumeration value="LIFESIG" />
    </xs:restriction>
  </xs:simpleType>
  
  <!-- CitiAnswer list - indicates the type of CitiAnswer -->
  <xs:simpleType name="CL_Enum_CitiAnswerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Alarm" />
      <xs:enumeration value="Device" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Alarm type list - indicates the type of alarm -->
  <xs:simpleType name="CL_Enum_AlarmType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="StopF" />
      <xs:enumeration value="SlowVeh" />
      <xs:enumeration value="Debris" />
      <xs:enumeration value="Pedestrian" />
      <xs:enumeration value="Visibility" />
      <xs:enumeration value="SlowDown" />
      <xs:enumeration value="WrongWay" />
    </xs:restriction>
  </xs:simpleType>
  
  <!-- Device type list - indicates the type of device -->
  <xs:simpleType name="CL_Enum_DeviceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Analyzer" />
    </xs:restriction>
  </xs:simpleType>
  
  <!-- Device state list - indicates the type of device state -->
  <xs:simpleType name="CL_Enum_DeviceStateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CommError" />
      <xs:enumeration value="OK" />
      <xs:enumeration value="NOK" />
      <xs:enumeration value="VideoError" />
      <xs:enumeration value="Warning" />
    </xs:restriction>
  </xs:simpleType>
  
  <!-- Request type list - indicates the type of request to query -->
  <xs:simpleType name="CL_Enum_RequestType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="alarms" />
      <xs:enumeration value="devices" />
      <xs:enumeration value="keepAlive" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
