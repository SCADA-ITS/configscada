<xs:schema xmlns:p="json_generic_mango_v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="json_generic_mango_v1" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="json_generic_mango_v1">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="groovy_adapter" minOccurs="0" maxOccurs="1" >
          <xs:complexType>
            <xs:attribute name="file" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      	<xs:element name="session_uid">
          <xs:complexType>
            <xs:attribute name="element_type_param_id" type="xs:long" use="required" />
            <xs:attribute name="param_type_id" type="xs:long" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="state">
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="state_value">
                <xs:complexType>
                  <xs:attribute name="source" type="xs:long" use="required" />
                  <xs:attribute name="input" type="xs:long" use="required" />
                  <xs:attribute name="disconnected" type="xs:boolean" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="field" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
        <xs:element name="fields" minOccurs="0" maxOccurs="1" >
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="field">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="source" type="xs:string" minOccurs="0" maxOccurs="1"/>
                    <xs:element name="input" minOccurs="0" maxOccurs="1" >
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="element_type_param_id" type="xs:long" />
                          <xs:element name="param_type_id" type="xs:long" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="use_adapter" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="alarms" minOccurs="0" maxOccurs="1" >
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="alarm">
                <xs:complexType>
                  <xs:attribute name="source" type="xs:string" use="required" />
                  <xs:attribute name="active_value" type="xs:string" use="required" />
                  <xs:attribute name="alarm_config_id" type="xs:long" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="version" type="xs:string" use="required" />
      <xs:attribute name="element_type_id" type="xs:long" use="required" />
      <xs:attribute name="array_element_id" type="xs:string" use="optional" />
    </xs:complexType>
  </xs:element>
</xs:schema>