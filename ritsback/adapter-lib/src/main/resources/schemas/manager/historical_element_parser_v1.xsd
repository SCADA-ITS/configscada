<?xml version="1.0" encoding="utf-8"?>
<xs:schema
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	attributeFormDefault="unqualified"
	targetNamespace="historical_element_parser_v1"
	elementFormDefault="qualified"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element
		name="historical_element_parser_v1">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="target_table" type="xs:string" />
				<xs:element name="table_space" type="xs:string" />
				<xs:element name="field_element_id" type="xs:string" />
				<xs:element name="field_timestamp" type="xs:string" minOccurs="0" maxOccurs ="1"/>
				<xs:element name="cron_expression" type="xs:string" minOccurs="0" maxOccurs ="1"/>
				<xs:element name="fields">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="field">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="element_type_param">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="element_type_param_id"
														type="xs:unsignedByte" />
													<xs:element name="param_type_id"
														type="xs:unsignedByte" />
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="name" type="xs:string"
										use="required" />
									<xs:attribute name="pk" type="xs:boolean"
										use="optional" />
									<xs:attribute name="indexed" type="xs:boolean"
										use="optional" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="element_type_id"
				type="xs:unsignedByte" use="required" />
		</xs:complexType>
	</xs:element>
</xs:schema>