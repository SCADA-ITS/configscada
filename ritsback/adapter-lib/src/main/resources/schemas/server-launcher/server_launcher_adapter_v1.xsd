<xs:schema xmlns:p="server_launcher_adapter_v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="server_launcher_adapter_v1" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="server_launcher_adapter_v1">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="general">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="check_alive_s" type="xs:unsignedByte" />
              <xs:element name="trace_stats_s" type="xs:unsignedByte" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="processes">
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="proc">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="name" type="xs:string" />
                    <xs:element name="path" type="xs:string" />
                    <xs:element name="executable" type="xs:string" />
                    <xs:element name="xml_adapter" type="xs:string"  minOccurs="0" maxOccurs="1"/>
                    <xs:element name="restart_on_fail" type="xs:boolean" />
                    <xs:element name="dependencies" type="xs:string"  minOccurs="0" maxOccurs="1"/>
                    <xs:element name="time_out" type="xs:long"  minOccurs="0" maxOccurs="1"/>
                    <xs:element name="parameters" minOccurs="0" maxOccurs="1">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element maxOccurs="unbounded" name="param" type="xs:string" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="thresholds" minOccurs="0" maxOccurs="1">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element maxOccurs="unbounded" name="threshold" type="xs:string" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:unsignedByte" use="required" />
                  <xs:attribute name="enabled" type="xs:boolean" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="version" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>