-- Disable message for next USE command
:setvar SQLCMDERRORLEVEL 1
USE [smartgen]
GO
-- Reenable
:setvar SQLCMDERRORLEVEL 0

SET ANSI_NULLS ON
SET ANSI_WARNINGS ON
SET NOCOUNT ON

DROP TABLE IF EXISTS dbo.order_details;
DROP TABLE IF EXISTS dbo.orders;
DROP TABLE IF EXISTS dbo.products;
DROP TABLE IF EXISTS dbo.subcategories;
DROP TABLE IF EXISTS dbo.categories;
DROP TABLE IF EXISTS dbo.customers;
GO

CREATE TABLE dbo.customers (
	customer_id bigint IDENTITY(1,1) NOT NULL,
	fullname varchar(200) NULL,
	name varchar(100) NULL,
	surname varchar(200) NULL,
	CONSTRAINT pk_customers PRIMARY KEY (customer_id)
);
GO
---

CREATE TABLE dbo.categories (
	category_id bigint IDENTITY(1,1) NOT NULL,
	name varchar(100) NULL,
	CONSTRAINT pk_categories PRIMARY KEY (category_id)
);
GO
---

CREATE TABLE dbo.subcategories (
	subcategory_id bigint IDENTITY(1,1) NOT NULL,
	category_id bigint NULL,
	name varchar(100) NULL,
	CONSTRAINT pk_subcategories PRIMARY KEY (subcategory_id)
);
GO
 CREATE NONCLUSTERED INDEX idx_subcategories_category_id ON dbo.subcategories (  category_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO

ALTER TABLE dbo.subcategories ADD CONSTRAINT fk_subcategories_category_id FOREIGN KEY (category_id) REFERENCES dbo.categories(category_id);
GO

---

CREATE TABLE dbo.products (
	product_id bigint IDENTITY(1,1) NOT NULL,
	product_name varchar(100) NULL,
	category_id bigint NULL,
	subcategory_id bigint NULL,
	price float DEFAULT 0 NULL,
	stock int DEFAULT 0 NULL,
	available bit NULL,
	CONSTRAINT pk_products PRIMARY KEY (product_id)
);
GO
 CREATE NONCLUSTERED INDEX idx_products_category_id ON dbo.products (  category_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO
 CREATE NONCLUSTERED INDEX idx_products_subcategory_id ON dbo.products (  subcategory_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO

ALTER TABLE dbo.products ADD CONSTRAINT fk_products_category_id FOREIGN KEY (category_id) REFERENCES dbo.categories(category_id) ON DELETE CASCADE;
GO
ALTER TABLE dbo.products ADD CONSTRAINT fk_products_subcategory_id FOREIGN KEY (subcategory_id) REFERENCES dbo.subcategories(subcategory_id) ON DELETE CASCADE;
GO

---

CREATE TABLE dbo.orders (
	order_id bigint IDENTITY(1,1) NOT NULL,
	customer_id bigint NOT NULL,
	comments varchar(1000) NULL,
	created_at datetimeoffset DEFAULT getdate() NOT NULL,
	CONSTRAINT pk_orders PRIMARY KEY (order_id)
);
GO
 CREATE NONCLUSTERED INDEX idx_orders_customer_id ON dbo.orders (  customer_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO


ALTER TABLE dbo.orders ADD CONSTRAINT fk_orders_customer_id FOREIGN KEY (customer_id) REFERENCES dbo.customers(customer_id) ON DELETE CASCADE;
GO

---

CREATE TABLE dbo.order_details (
	order_detail_id bigint IDENTITY(1,1) NOT NULL,
	order_id bigint NULL,
	product_id bigint NULL,
	qty int DEFAULT 0 NULL,
	CONSTRAINT pk_order_details PRIMARY KEY (order_detail_id)
);
GO
 CREATE NONCLUSTERED INDEX idx_order_details_order_id ON dbo.order_details (  order_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO
 CREATE NONCLUSTERED INDEX idx_order_details_product_id ON dbo.order_details (  product_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO

ALTER TABLE dbo.order_details ADD CONSTRAINT fk_order_details_order_id FOREIGN KEY (order_id) REFERENCES dbo.orders(order_id) ON DELETE CASCADE;
GO
ALTER TABLE dbo.order_details ADD CONSTRAINT fk_order_details_product_id FOREIGN KEY (product_id) REFERENCES dbo.products(product_id) ON DELETE CASCADE;
GO