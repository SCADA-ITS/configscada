-- Table: dbo.sg_metadata_tables
-- Descripción: 
-- Scope: 
--

CREATE TABLE dbo.sg_metadata_tables (
	id int IDENTITY(1,1) NOT NULL,
	name varchar(100) NOT NULL,
	label varchar(100) NULL,
	label_singular varchar(100) NULL,
	label_description varchar(100) NULL,
	mdi_icon varchar(100) NULL,
	support_images bit NOT NULL,
	support_attachments bit NOT NULL,
	sql_view varchar(4000) null,
	grid_id int NULL,
	metadata varchar(2000) NULL,
	CONSTRAINT pk_sg_metadata_tables PRIMARY KEY (id)
);
GO
 CREATE  UNIQUE NONCLUSTERED INDEX sg_metadata_tables_name_key ON dbo.sg_metadata_tables (  name ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO
	 
-- Table: dbo.sg_metadata_table_images
-- Descripción: 
-- Scope: 
--
CREATE TABLE dbo.sg_metadata_table_images (
	id int IDENTITY(1,1) NOT NULL,
	sg_metadata_table_id int NOT NULL,
	id_value int NOT NULL,
	group_name varchar(100) NOT NULL,
	file_name varchar(200) NOT NULL,
	description varchar(200) NULL,
	[position] int NOT NULL,
	CONSTRAINT pk_sg_metadata_table_images PRIMARY KEY (id)
);
GO
 CREATE NONCLUSTERED INDEX idx_sg_metadata_table_images_sg_metadata_table_id ON dbo.sg_metadata_table_images (  sg_metadata_table_id ASC  )  
	 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
	 ON [PRIMARY ] ;
GO


ALTER TABLE dbo.sg_metadata_table_images ADD CONSTRAINT fk_sg_metadata_table_images_sg_metadata_table_id FOREIGN KEY (sg_metadata_table_id) REFERENCES dbo.sg_metadata_tables(id);
GO

