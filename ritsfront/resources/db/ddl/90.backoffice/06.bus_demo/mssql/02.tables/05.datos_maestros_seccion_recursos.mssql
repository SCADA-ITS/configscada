	GO
	
	ALTER TABLE dbo.VW_RCS_VEHICULOS ADD CONSTRAINT FK_VW_RCS_VEHICULOS_RVE_TEM_ID FOREIGN KEY (RVE_TEM_ID) REFERENCES dbo.VW_TPL_EMPRESAS(TEM_ID);
	GO
	
	-- dbo.VW_RCS_VEHICULOS.RVE_RCQ_ID foreign keys
	
	CREATE NONCLUSTERED INDEX IDX_VW_RCS_VEHICULOS_RVE_RCQ_ID ON dbo.VW_RCS_VEHICULOS (  RVE_RCQ_ID ASC  )  
		 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
		 ON [PRIMARY ];
	GO
	
	ALTER TABLE dbo.VW_RCS_VEHICULOS ADD CONSTRAINT FK_VW_RCS_VEHICULOS_RVE_RCQ_ID FOREIGN KEY (RVE_RCQ_ID) REFERENCES dbo.VW_RCS_CROQUIS(RCQ_ID);
	GO
	
