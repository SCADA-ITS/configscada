		RVE_KMS int NULL,
		RVE_LONGITUD tinyint NULL,
		RVE_VLD_MAX tinyint NULL,
		RVE_F_ALTA date NULL,
		RVE_F_BAJA date NULL,
		RVE_OBS varchar(MAX) NULL,
		CONSTRAINT PK_VW_RCS_VEHICULOS PRIMARY KEY (RVE_ID)
	);
	GO
	
	-- dbo.VW_RCS_VEHICULOS.RVE_TEM_ID foreign keys
	
