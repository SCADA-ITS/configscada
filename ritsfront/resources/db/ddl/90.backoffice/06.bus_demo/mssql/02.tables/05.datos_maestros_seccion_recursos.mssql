--
-- Table: dbo.VW_RCS_CROQUIS
--

	CREATE TABLE dbo.VW_RCS_CROQUIS (
		RCQ_ID int IDENTITY(1,1) NOT NULL,
		RCQ_CODIGO varchar(15) NULL,
		RCQ_NOMBRE varchar(100) NULL,
		RCQ_OCUPACION_MAX smallint NULL,
		RCQ_OCUPACION_NO_NUM smallint NULL,
		RCQ_PLAZA_ASNT_NUM smallint NULL,
		RCQ_PLAZA_PRM_NUM smallint NULL,
		RCQ_PLAZA_PSLL_NUM smallint NULL,
		RCQ_PLAZA_SC_NUM smallint NULL,
		RCQ_F_ALTA date NULL,
		RCQ_F_BAJA date NULL,
		RCQ_OBS varchar(MAX) NULL,
		CONSTRAINT PK_VW_RCS_CROQUIS PRIMARY KEY (RCQ_ID)
	);
	GO

--
-- Table: dbo.VW_RCS_VEHICULOS
--

	CREATE TABLE dbo.VW_RCS_VEHICULOS (
		RVE_ID int IDENTITY(1,1) NOT NULL,
		RVE_TEM_ID int NULL, -- dbo.VW_TPL_EMPRESAS
		RVE_RVT_ID smallint NULL,
		RVE_RVT_CODIGO varchar(10) NULL,
		RVE_RVT_NOMBRE varchar(100) NULL,
		RVE_CODIGO varchar(10) NULL,
		RVE_NOMBRE varchar(100) NULL,
		RVE_RCQ_ID int NULL, -- dbo.VW_RCS_CROQUIS
		RVE_RVS_ID smallint NULL,
		RVE_RVS_CODIGO varchar(10) NULL,
		RVE_RVS_NOMBRE varchar(100) NULL,
		RVE_MATRICULA varchar(15) NULL,
