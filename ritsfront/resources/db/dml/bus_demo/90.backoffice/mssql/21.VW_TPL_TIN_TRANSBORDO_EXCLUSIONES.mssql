-- Disable message for next USE command
:setvar SQLCMDERRORLEVEL 1
USE [bus_demo]
GO
-- Reenable
:setvar SQLCMDERRORLEVEL 0

SET ANSI_NULLS ON
SET ANSI_WARNINGS ON
SET NOCOUNT ON

SET IDENTITY_INSERT dbo.VW_TPL_TIN_TRANSBORDO_EXCLUSIONES ON;  
GO
	
SET IDENTITY_INSERT dbo.VW_TPL_TIN_TRANSBORDO_EXCLUSIONES OFF;  
GO