--
-- Table: dbo.TMP_ASIGNACION_DISP_VEH
--

	CREATE TABLE dbo.CUSTOM_TKDISVEH_DISPOSITIVOS (
		ID int IDENTITY(1,1) NOT NULL,
		RVE_CODIGO nvarchar(10) NULL,
		RVE_NOMBRE int NULL,
		ASSIGNMENT_DAT datetime NULL,
		RDS_ID int NULL,
		RDS_RDT_ID smallint NULL,
		RDS_RDT_CODIGO varchar(10) NULL,
		RDS_RDT_NOMBRE varchar(100) NULL,
		RDS_CODIGO int NULL,
		RDS_NOMBRE varchar(100) NULL,
		RDS_SERIE_NRO varchar(50) NULL,
		RDS_GARANTIA_PERIODO tinyint NULL,
		RDS_F_COMPRA date NULL
		CONSTRAINT PK_TMP_TKDISVEH_DISPOSITIVOS PRIMARY KEY (ID)
	);
	GO
	
	
--
-- View: dbo.TKDISVEH_DISPOSITIVOS
--
	
	CREATE OR ALTER VIEW dbo.TKDISVEH_DISPOSITIVOS AS 
	SELECT ID, RVE_CODIGO, RVE_NOMBRE, 
		   ASSIGNMENT_DAT, RDS_ID, RDS_RDT_ID, 
		   RDS_RDT_CODIGO, RDS_RDT_NOMBRE, 
		   RDS_CODIGO, RDS_NOMBRE, RDS_SERIE_NRO, 
		   RDS_GARANTIA_PERIODO, RDS_F_COMPRA 
	  FROM dbo.CUSTOM_TKDISVEH_DISPOSITIVOS
	GO

--
-- Table: dbo.CUSTOM_IMPORTACIONES_RECAUDACION_CONDUCTOR
--	
	CREATE TABLE dbo.CUSTOM_IMPORTACIONES_RECAUDACION_CONDUCTOR (
		CIRC_ID int IDENTITY(1,1) NOT NULL,
		FICHERO varchar(100) NULL,
		FECHA_PROCESADO datetimeoffset NULL,
		CONTENIDO varchar(4000) NULL,
		CONSTRAINT PK_CUSTOM_IMPORTACIONES_RECAUDACION_CONDUCTOR PRIMARY KEY (CIRC_ID)
	);
	GO