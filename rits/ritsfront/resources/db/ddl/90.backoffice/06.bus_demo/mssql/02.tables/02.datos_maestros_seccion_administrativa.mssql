--
-- Table: dbo.VW_ADM_CONSORCIOS
--

	CREATE TABLE dbo.VW_ADM_CONSORCIOS (
		ACS_ID int IDENTITY(1,1) NOT NULL,
		ACS_CODIGO varchar(10)  NULL,
		ACS_NOMBRE varchar(100) NULL,
		ACS_POR_DEFECTO bit NOT NULL,
		CONSTRAINT PK_VW_ADM_CONSORCIOS PRIMARY KEY (ACS_ID)
	);	
	GO


--
-- Table: dbo.VW_ADM_SOPORTES
--

	CREATE TABLE dbo.VW_ADM_SOPORTES (
		ASP_ID int IDENTITY(1,1) NOT NULL,
		ASP_ACS_ID int NULL, -- dbo.VW_ADM_CONSORCIOS
		ASP_CODIGO varchar(10) NULL,
		ASP_NOMBRE varchar(100)  NULL,
		CONSTRAINT PK_VW_ADM_SOPORTES PRIMARY KEY (ASP_ID)
	);
	GO

	-- dbo.VW_ADM_SOPORTES.ASP_ACS_ID foreign keys
	
	CREATE NONCLUSTERED INDEX IDX_VW_ADM_SOPORTES_ASP_ACS_ID ON dbo.VW_ADM_SOPORTES (  ASP_ACS_ID ASC  )  
		 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
		 ON [PRIMARY ];
	GO
	
	ALTER TABLE dbo.VW_ADM_SOPORTES ADD CONSTRAINT FK_VW_ADM_SOPORTES_ASP_ACS_ID FOREIGN KEY (ASP_ACS_ID) REFERENCES dbo.VW_ADM_CONSORCIOS(ACS_ID);
	GO
	
--
-- Table: dbo.VW_ADM_CONCESION_TIPOS
--

	CREATE TABLE dbo.VW_ADM_CONCESION_TIPOS (
		ACT_ID int IDENTITY(1,1) NOT NULL,
