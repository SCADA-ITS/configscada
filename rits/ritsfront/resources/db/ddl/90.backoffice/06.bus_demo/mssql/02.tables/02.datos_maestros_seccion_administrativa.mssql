		ACT_NOMBRE varchar(100) NULL,
		ACT_EN_CPR bit NULL,
		ACT_ACS_ID INT NULL, -- dbo.VW_ADM_CONSORCIOS
		CONSTRAINT PK_VW_ADM_CONCESION_TIPOS PRIMARY KEY (ACT_ID)
	);
	GO

	-- dbo.VW_ADM_CONCESION_TIPOS.ACT_ACS_ID foreign keys
	
	CREATE NONCLUSTERED INDEX IDX_VW_ADM_SOPORTES_ACT_ACS_ID ON dbo.VW_ADM_CONCESION_TIPOS (  ACT_ACS_ID ASC  )  
		 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
		 ON [PRIMARY ];
	GO
	
	ALTER TABLE dbo.VW_ADM_CONCESION_TIPOS ADD CONSTRAINT FK_VW_ADM_SOPORTES_ACT_ACS_ID FOREIGN KEY (ACT_ACS_ID) REFERENCES dbo.VW_ADM_CONSORCIOS(ACS_ID);
	GO
	