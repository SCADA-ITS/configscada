--
-- Table: dbo.VW_CRN_CALENDARIOS
--
	CREATE TABLE dbo.VW_CRN_CALENDARIOS (
		CCL_ID int IDENTITY(1,1) NOT NULL,
		CCL_CODIGO varchar(15) NULL,
		CCL_NOMBRE varchar(100) NULL,
		CCL_CDT_ID smallint NULL,
		CCL_CDT_CODIGO varchar(10) NULL,
		CCL_CDT_NOMBRE varchar(100) NULL,
		CCL_CDT_LUNES bit NULL,
		CCL_CDT_MARTES bit NULL,
		CCL_CDT_MIERCOLES bit NULL,
		CCL_CDT_JUEVES bit NULL,
		CCL_CDT_VIERNES bit NULL,
		CCL_CDT_SABADO bit NULL,
		CCL_CDT_DOMINGO bit NULL,
		CCL_CDT_FESTIVOS bit NULL,
		CCL_F_INICIAL date NULL,
		CCL_F_FINAL date NULL,
		CONSTRAINT PK_VW_CRN_CALENDARIOS PRIMARY KEY (CCL_ID)
	);
	GO
	
