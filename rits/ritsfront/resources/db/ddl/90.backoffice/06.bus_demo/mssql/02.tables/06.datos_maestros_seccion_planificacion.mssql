		PTR_NOMBRE varchar(100) NULL,
		CONSTRAINT PK_VW_PLN_TURNOS PRIMARY KEY (PTR_ID)
	);
	GO
	
	-- dbo.VW_PLN_TURNOS.RVE_TEM_ID foreign keys
	
	CREATE NONCLUSTERED INDEX IDX_VW_PLN_TURNOS_PTR_TEM_ID ON dbo.VW_PLN_TURNOS (  PTR_TEM_ID ASC  )  
		 WITH (  PAD_INDEX = OFF ,FILLFACTOR = 99   ,SORT_IN_TEMPDB = OFF , IGNORE_DUP_KEY = OFF , STATISTICS_NORECOMPUTE = OFF , ONLINE = OFF , ALLOW_ROW_LOCKS = ON , ALLOW_PAGE_LOCKS = ON  )
