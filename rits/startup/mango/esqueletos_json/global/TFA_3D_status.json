{
   "publishers": [
      {
         "publishAttributeChanges": true,
         "cacheWarningSize": 100,
         "dateFormat": "DATE_FORMAT_UTC",
         "useJSON": true,
         "snapshotSendPeriods": 5,
         "raiseResultWarning": true,
         "staticParameters": [],
         "sendSnapshot": false,
         "type": "HTTP_SENDER",
         "usePost": true,
         "enabled": true,
         "url": "{url_publisher}",
         "points": [
            {
               "dataPointId": "DP_{section_name}_status",
               "parameterName": "status",
               "includeTimestamp": false
            }
         ],
         "xid": "PUB_{section_name}",
         "publishType": "CHANGES_ONLY",
         "alarmLevels": {
            "POINT_DISABLED_EVENT": "DO_NOT_LOG",
            "RESULT_WARNINGS_EVENT": "DO_NOT_LOG",
            "SEND_EXCEPTION_EVENT": "DO_NOT_LOG",
            "QUEUE_SIZE_WARNING_EVENT": "DO_NOT_LOG"
         },
         "staticHeaders": [
            {
               "value": "{section_name}",
               "key": "session-uid"
            }
         ],
         "name": "{section_name}",
         "snapshotSendPeriodType": "MINUTES",
         "cacheDiscardSize": 1000
      }
   ]
}