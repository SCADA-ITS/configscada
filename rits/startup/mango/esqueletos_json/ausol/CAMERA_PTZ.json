        "logCount":5,
        "logSize":1.0,
        "script":"\nvar headers = {ContentType : \"application\/xml\"};\nvar url = \"http:\/\/\" + authorization.value + \"@\" + ip.value + \"\/ISAPI\/PTZCtrl\/channels\/1\/Momentary\";\nvar result;\nvar jsonCommand = JSON.parse(moveCommand.value);\nvar pan = jsonCommand[0];\nvar tilt = jsonCommand[1];\nvar zoom = jsonCommand[2];\nvar parameters = '<?xml version=\"1.0\" encoding=\"utf-8\"?><PTZData><pan>' + pan +'<\/pan><tilt>' + tilt + '<\/tilt><zoom>' + zoom + '<\/zoom><Momentary><duration>100<\/duration><\/Momentary><\/PTZData>';\nLOG.debug(parameters);\n\n\nHttpBuilder.put(url, headers, parameters).resp(function(statusCode, headers, content) { \n  \/\/ handle the response, maybe return \"Success!\" or whatever\n  result = statusCode;\n}).err(function(statusCode, headers, content) {\n \/\/ handle error responses\n   result = statusCode;\n}).execute();\n\nreturn result;\n",
