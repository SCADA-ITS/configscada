  "dataPoints":[
    {
      "xid":"DP_{device_name}_rate",
      "name":"rate",
      "enabled":true,
      "loggingType":"ON_CHANGE",
      "intervalLoggingPeriodType":"MINUTES",
      "intervalLoggingType":"AVERAGE",
      "purgeType":"YEARS",
      "pointLocator":{
        "dataType":"ALPHANUMERIC",
        "updateEvent":"NONE",
        "contextUpdateEvent":"CONTEXT_UPDATE",
        "context":[
          {
            "varName":"ocupacion_espira_cabeza_{det_order}",
            "dataPointXid":"DP_{det_name}_ocupacion_espira_cabeza",
            "updateContext":true
          },
          {
            "varName":"velocidad_media_{det_order}",
            "dataPointXid":"DP_{det_name}_velocidad_media",
            "updateContext":true
          },
          {
            "varName":"Air_Temperature",
            "dataPointXid":"DP_{meteo_name}_Air_Temperature",
            "updateContext":true
          },
          {
            "varName":"Surface_Temperature",
            "dataPointXid":"DP_{meteo_name}_Surface_Temperature",
            "updateContext":true
          },
          {
            "varName":"numero_detector_{det_order}",
            "dataPointXid":"DP_{det_name}_numero_detector",
            "updateContext":false
          },
          {
            "varName":"intensidad_total_{det_order}",
            "dataPointXid":"DP_{det_name}_intensidad_total",
            "updateContext":false
          }
        ],
        "logLevel":"NONE",
        "variableName":"my",
        "scriptPermissions":[
        ],
        "executionDelaySeconds":0,
        "logCount":5,
        "logSize":1.0,
        "script":"var rate = [];     \nfor (i = 1; i <= 4; i++) {\n    LOG.info(this['velocidad_media_' + i]);\n    if(typeof this['velocidad_media_' + i] != 'undefined'){\n        var vms = new Object(); \n        \n        vms.average_speed = this['velocidad_media_' + i].value;\n        vms.occupancy = this['ocupacion_espira_cabeza_' + i].value;\n        vms.num_detector = this['numero_detector_' + i].value;\n        vms.num_vehicles = this['intensidad_total_' + i].value;\n        rate.push(vms)\n      \n    }\n    if (i == 1){\n        var vms = new Object(); \n        vms.air_temperature = this['Air_Temperature'].value;\n        vms.surface_temperature = this['Surface_Temperature'].value;\n        rate.push(vms)\n    }\n\n}\n\n\n\nvar jsonString = JSON.stringify(rate);\n\nreturn jsonString;",
        "settable":false,
        "updateCronPattern":""
      },
      "eventDetectors":[
      ],
      "plotType":"STEP",
      "rollup":"NONE",
