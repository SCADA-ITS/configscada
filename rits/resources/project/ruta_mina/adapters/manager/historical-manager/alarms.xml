<?xml version="1.0" encoding="UTF-8"?>
<p:historical_instant_parser_v2
	xmlns:p="historical_instant_parser_v2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="historical_instant_parser_v2 ../../../../adapter-lib/src/main/resources/schemas/manager/historical_instant_parser_v2.xsd "
	model="Alarm">
	<p:target_table>hist.alarms</p:target_table>
	<p:table_space>tbl_hist</p:table_space>
	<p:fields>
		<p:field name="Alias">
			<p:soure_field_value>alias</p:soure_field_value>
			<p:source_entity>AlarmConfig</p:source_entity>
			<p:references>
				<p:reference sourceField="id"
					targetField="alarmConfigId" />
			</p:references>
		</p:field>
		<p:field name="Source_Element">
			<p:soure_field_value>alias</p:soure_field_value>
			<p:source_entity>Element</p:source_entity>
			<p:references>
				<p:reference sourceField="id"
					targetField="sourceElementId" />
				<p:reference sourceField="elementTypeId"
					targetField="sourceElementTypeId" />
			</p:references>
		</p:field>
		<p:field name="Target_Element">
			<p:soure_field_value>alias</p:soure_field_value>
			<p:source_entity>Element</p:source_entity>
			<p:references>
				<p:reference sourceField="id"
					targetField="targetElementId" />
				<p:reference sourceField="elementTypeId"
					targetField="targetElementTypeId" />
			</p:references>
		</p:field>
		<p:field name="Activation">
			<p:soure_field_value>activation</p:soure_field_value>
		</p:field>
		<p:field name="Activation_Comments">
			<p:soure_field_value>activationComments</p:soure_field_value>
		</p:field>
		<p:field name="Recognized">
			<p:soure_field_value>recognized</p:soure_field_value>
		</p:field>
		<p:field name="Recognized_User">
			<p:soure_field_value>fullName</p:soure_field_value>
			<p:source_entity>User</p:source_entity>
			<p:references>
				<p:reference sourceField="id"
					targetField="recognizedUserId" />
			</p:references>
		</p:field>
		<p:field name="Recognized_Comments">
			<p:soure_field_value>recognizedComments</p:soure_field_value>
		</p:field>
		<p:field name="Deactivation">
			<p:soure_field_value>deactivation</p:soure_field_value>
		</p:field>
		<p:field name="Deactivation_Comments">
			<p:soure_field_value>deactivationComments</p:soure_field_value>
		</p:field>
		<p:field name="Disagree">
			<p:soure_field_value>disagree</p:soure_field_value>
		</p:field>
	</p:fields>
</p:historical_instant_parser_v2>
