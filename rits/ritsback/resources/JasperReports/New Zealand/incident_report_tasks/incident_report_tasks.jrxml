		<parameter name="fechaini" class="java.sql.Timestamp"/>
		<parameter name="fechafin" class="java.sql.Timestamp"/>
		<queryString language="SQL">
			<![CDATA[SELECT 
	hist.ims_incident_report_task_states.incident_report_id,
	iit.alias as "Incident type",
	iitt.alias as "Incident type task",
	u.name_ as "User",
	iitt.mandatory,
	iitt.auto,
	hist.ims_incident_report_task_states.created_at,
	hist.ims_incident_report_task_states.completed_at
FROM hist.ims_incident_report_task_states
inner join conf.ims_incident_type_tasks iitt on iitt.incident_type_task_id = hist.ims_incident_report_task_states.incident_type_task_id 
inner join rt.ims_incident_reports iir on iir.incident_report_id = hist.ims_incident_report_task_states.incident_report_id 
inner join conf.ims_incident_types iit on iir.incident_type_id = iit.incident_type_id 
inner join conf.users u on u.user_id = iit.default_user_id
WHERE $X{[BETWEEN], hist.ims_incident_report_task_states.created_at, fechaini, fechafin}]]>
		</queryString>
