									<font size="6"/>
								</textElement>
								<textFieldExpression><![CDATA[$F{description}.equals("Accidente con implicación de SSPP, con fuga, derrame, incendio o explosión.") ? $R{Accidente con implicacion de SSPP, con fuga, derrame, incendio o explosion} :
$F{description}.equals("Accidente con implicación de SSPP, sin fuga, derrame, incendio o explosión." ) ? $R{Accidente con implicacion de SSPP, sin fuga, derrame, incendio o explosion} :
$F{description}.equals( "Accidente que afecta a dos carriles de circulación sin implicación de SSPP." ) ? $R{Accidente que afecta a dos carriles de circulacion sin implicaciu00F3n de SSPP} :
$F{description}.equals( "Accidente que afecta a un carril de circulación sin implicación de SSPP." ) ? $R{Accidente que afecta a un carril de circulacion sin implicacion de SSPP} :
$F{description}.equals( "Alta concentración de CO y/o NOx." ) ? $R{Alta concentracion de CO y/o NOx} :
$F{description}.equals("Amenaza de bomba o amenaza de atentado."  ) ? $R{Amenaza de bomba o amenaza de atentado} :
$F{description}.equals( "Condiciones de servicio degradado - Nivel 1." ) ? $R{Condiciones de servicio degradado - Nivel 0} :
$F{description}.equals("Condiciones de servicio degradado - Nivel 2."  ) ? $R{Condiciones de servicio degradado - Nivel 1} :
$F{description}.equals("Condiciones de servicio degradado – Nivel 0"  ) ? $R{Condiciones de servicio degradado - Nivel 2} :
$F{description}.equals("Conducción temeraria."  ) ? $R{Conduccion temeraria} :
$F{description}.equals("Daños estructurales con riesgo inminente."  ) ? $R{Dau00F1os estructurales con riesgo inminente} :
$F{description}.equals("Derrame de líquidos (firme deslizante)."  ) ? $R{Derrame de liquidos firme deslizante} :
