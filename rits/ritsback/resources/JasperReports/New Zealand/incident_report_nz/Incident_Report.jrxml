	<subDataset name="incidents" uuid="8db5b4b9-aaab-4a7a-abde-98fc7ec8c526">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="rits 171"/>
		<parameter name="strtipo" class="java.util.Collection"/>
		<parameter name="strtramo" class="java.util.Collection"/>
		<parameter name="strnivel" class="java.util.Collection"/>
		<parameter name="fechainicio" class="java.sql.Timestamp"/>
		<parameter name="fechafin" class="java.sql.Timestamp"/>
		<queryString language="SQL">
			<![CDATA[SELECT hist.ims_incident_reports.incident_report_id,
	iit.alias as "incident_type_id",
	iit.description as "description",
	s.alias as "affection_stretch",
	l.alias as "location",
	iis.alias as "incident_state",
	iil.alias as "incident_level",
	u.full_name as "current_user",
	hist.ims_incident_reports.confirm as "confirm",
	iitc.alias as "incident_type_cause",
	hist.ims_incident_reports.generated_at,
	hist.ims_incident_reports.created_at,
	hist.ims_incident_reports.last_update
FROM hist.ims_incident_reports
inner join conf.ims_incident_types iit on iit.incident_type_id = hist.ims_incident_reports.incident_type_id
inner join conf.stretchs s on s.stretch_id = hist.ims_incident_reports.affection_stretch_id
inner join conf.locations l on l.location_id = hist.ims_incident_reports.location_id
inner join static.ims_incident_states iis on iis.incident_state_id = hist.ims_incident_reports.incident_state_id
inner join static.ims_incident_levels iil on iil.incident_level_id = hist.ims_incident_reports.incident_level_id
inner join conf.users u on u.user_id = hist.ims_incident_reports.current_user_id
left join conf.ims_incident_type_causes iitc on iitc.incident_type_cause_id = hist.ims_incident_reports.incident_type_cause_id
where $X{IN, iit.description, strtipo} and  $X{IN, s.alias, strtramo}  and $X{[BETWEEN], hist.ims_incident_reports.generated_at, fechainicio, fechafin}
order by hist.ims_incident_reports.generated_at]]>
		</queryString>
