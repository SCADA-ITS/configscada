	<subDataset name="Dataset1" uuid="33d943c4-effc-410d-98e0-614b35ce7f7d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="rits 171"/>
		<parameter name="fechaini" class="java.sql.Timestamp"/>
		<parameter name="fechafin" class="java.sql.Timestamp"/>
		<queryString language="SQL">
			<![CDATA[SELECT
 	hist.ims_incident_report_logs.incident_report_id,
	iit.alias,
	iirlv.value,
	u.name_,
	hist.ims_incident_report_logs.log_timestamp

FROM hist.ims_incident_report_logs
inner join hist.ims_incident_report_log_values iirlv on iirlv.incident_report_log_id = hist.ims_incident_report_logs.incident_report_log_id
inner join hist.ims_incident_reports iir on iir.incident_report_id = hist.ims_incident_report_logs.incident_report_id 
inner join conf.ims_incident_types iit on iir.incident_type_id = iit.incident_type_id 
inner join conf.users u on u.user_id = hist.ims_incident_report_logs.user_id
WHERE $X{[BETWEEN], hist.ims_incident_report_logs.log_timestamp, fechaini, fechafin}]]>
		</queryString>
		<field name="incident_report_id" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="incident_report_id"/>
			<property name="com.jaspersoft.studio.field.label" value="incident_report_id"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ims_incident_report_logs"/>
		</field>
		<field name="alias" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="alias"/>
			<property name="com.jaspersoft.studio.field.label" value="alias"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ims_incident_types"/>
		</field>
		<field name="value" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="value"/>
			<property name="com.jaspersoft.studio.field.label" value="value"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ims_incident_report_log_values"/>
		</field>
		<field name="name_" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="name_"/>
			<property name="com.jaspersoft.studio.field.label" value="name_"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="users"/>
		</field>
		<field name="log_timestamp" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="log_timestamp"/>
			<property name="com.jaspersoft.studio.field.label" value="log_timestamp"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ims_incident_report_logs"/>
		</field>
	</subDataset>
	<parameter name="fini" class="java.sql.Timestamp"/>
	<parameter name="ffin" class="java.sql.Timestamp"/>
	<queryString language="SQL">
		<![CDATA[SELECT rt.ims_incident_reports.incident_report_id,
	rt.ims_incident_reports.incident_type_id,
	rt.ims_incident_reports.incident_type_cause_id,
	rt.ims_incident_reports.affection_stretch_id,
	rt.ims_incident_reports.location_id,
	rt.ims_incident_reports.incident_state_id,
	rt.ims_incident_reports.incident_level_id,
	rt.ims_incident_reports.current_user_id,
	rt.ims_incident_reports.valid_for_min,
	rt.ims_incident_reports.confirm,
	rt.ims_incident_reports.enabled,
	rt.ims_incident_reports.visible,
	rt.ims_incident_reports.last_update,
	rt.ims_incident_reports.generated_at,
	rt.ims_incident_reports.created_at,
	rt.ims_incident_reports.updated_at
FROM rt.ims_incident_reports]]>
	</queryString>
