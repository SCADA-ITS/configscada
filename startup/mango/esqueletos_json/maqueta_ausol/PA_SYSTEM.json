        "script": "var command_parameters = JSON.parse(start_paging_command.value);\nfor(var i = 0;i< command_parameters[\"zones\"].length;i++)\n{\n    var prerecorded = \n    {\n        \"repetitions\": command_parameters[\"repetitions\"],\n        \"interval\": 0,\n        \"period\": 0,\n        \"start_time\": 0,\n        \"stop_time\": 0,\n        \"playing_message\": 0,\n        \"sequence\": 0,\n        \"messages\": command_parameters[\"messages\"],\n        \"messages_names\": []\n    }\n    var data = {\n        \"SenderIp\": \"\", \n        \"SenderInput\": -1,\n        \"InputTag\": \"\",\n        \"Type\": 1,\n        \"Priority\": 255,\n        \"Chime\": 0,\n        \"Id\": -1,\n        \"Zones\": [command_parameters[\"zones\"][i]],\n        \"Groups\": [],\n        \"Prerecorded\": prerecorded\n        \n    }\n    \n    var json = {\n        \"version\":  \"1\",\n        \"command\":  \"start_prerecorded\",\n        \"type\": \"set\",\n        \"data\": JSON.stringify(data)\n    }\n    var hex_command = a2hex(JSON.stringify(json));\n    hex_command += \"00\";\n    write_command.set(hex_command);\n}\n\nreturn start_paging_command.value;",
