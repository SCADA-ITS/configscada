        "scriptPermissions": [
          "superadmin"
        ],
        "executionDelaySeconds": 0,
        "logCount": 5,
        "logSize": 1.0,
        "script": "var list = paging_list.value;\nvar str_aux = list.substr(0,list.indexOf('\\0'));\nvar meesages_on_air =  {} ;\nvar messages = [];\nmeesages_on_air.messages= messages;\ntry\n{\n    var json = JSON.parse(str_aux);\n    var json_data =JSON.parse(json[\"data\"]);\n \n    for(var i=0;i<json_data[\"missatges\"].length;i++)\n    {\n       var message =\n       {\n           \"status\": json_data[\"missatges\"][i][\"Status\"],\n           \"zones\": json_data[\"missatges\"][i][\"Zones\"],\n           \"system_id\": json_data[\"missatges\"][i][\"Id\"],\n           \"sender_ip\": json_data[\"missatges\"][i][\"SenderIp\"],\n           \"messagesIds\": json_data[\"missatges\"][i][\"Prerecorded\"] ? json_data[\"missatges\"][i][\"Prerecorded\"][\"messages\"]  : \"\",\n           \"messages_names\": json_data[\"missatges\"][i][\"Prerecorded\"] ? json_data[\"missatges\"][i][\"Prerecorded\"][\"messages_names\"] : \"\",\n           \"type_message\": json_data[\"missatges\"][i][\"InputTag\"]\n           \n       }\n        meesages_on_air.messages.push(message);\n       \n    }\n   \n}catch (error)\n{\n    LOG.info(error);\n}\nreturn JSON.stringify(meesages_on_air);\n\n",
