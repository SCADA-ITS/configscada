{
  "sstGlobalScripts": [
    {
      "xid": "GS_a2hex",
      "name": "a2hex",
      "script": "function a2hex(str) {\n  var arr = [];\n  for (var i = 0, l = str.length; i < l; i ++) {\n    var hex = Number(str.charCodeAt(i)).toString(16);\n    arr.push(hex);\n  }\n  return arr.join('');\n}"
    },
    {
      "xid": "GS_hex2a",
      "name": "hex2a",
      "script": "function hex2a(hexx) {\n var hex = hexx.toString();\/\/force conversion\n    var str = '';\n    for (var i = 0; i < hex.length; i += 2)\n        str += String.fromCharCode(parseInt(hex.substr(i, 2), 16));\n    return str;\n}"
    }
  ],
