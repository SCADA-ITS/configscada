            "script":"\nif(bit_a.value == false && bit_b.value == false && bit_c.value == false && bit_d.value ==true){\n    return 10\n} else if(bit_a.value == true  &&  bit_b.value == false  &&  bit_c.value == false  &&  bit_d.value ==true){\n    return 20\n} else if(bit_a.value == true  &&  bit_b.value == false  &&  bit_c.value == false  &&  bit_d.value ==false){\n    return 30\n} else if(bit_a.value == false  &&  bit_b.value == true  &&  bit_c.value == false  &&  bit_d.value ==false){\n    return 40\n} else if(bit_a.value == true  &&  bit_b.value == true  &&  bit_c.value == false  &&  bit_d.value ==false){\n    return 50\n} else if(bit_a.value == false  &&  bit_b.value == false  &&  bit_c.value == true  &&  bit_d.value ==false){\n    return 60\n} else if(bit_a.value == true  &&  bit_b.value == false  &&  bit_c.value == true  &&  bit_d.value ==false){\n    return 70\n} else if(bit_a.value == false  &&  bit_b.value == true  &&  bit_c.value == true  &&  bit_d.value ==false){\n    return 80\n} else if(bit_a.value == true  &&  bit_b.value == true  &&  bit_c.value == true  &&  bit_d.value ==false){\n    return 90\n} else if(bit_a.value == false  &&  bit_b.value == true  &&  bit_c.value == false  &&  bit_d.value ==true){\n    return 100\n} else if(bit_a.value == true  &&  bit_b.value == true  &&  bit_c.value == false  &&  bit_d.value ==true){\n    return 110\n} else if(bit_a.value == false  &&  bit_b.value == false  &&  bit_c.value == true  &&  bit_d.value ==true){\n    return 120\n} else if(bit_a.value == true  &&  bit_b.value == false  &&  bit_c.value == true  &&  bit_d.value ==true){\n    return 130\n} else if(bit_a.value == true  &&  bit_b.value == false  &&  bit_c.value == true  &&  bit_d.value ==true){\n    return 140\n}",
