            "script":"if (signal.value == 10){\n    bit_A_order.set(false);\n    bit_B_order.set(false);\n    bit_C_order.set(false);\n    bit_D_order.set(true);\n} else if (signal.value == 20){\n    bit_A_order.set(true);\n    bit_B_order.set(false);\n    bit_C_order.set(false);\n    bit_D_order.set(true);\n} else if (signal.value == 30){\n    bit_A_order.set(true);\n    bit_B_order.set(false);\n    bit_C_order.set(false);\n    bit_D_order.set(false);\n} else if (signal.value == 40){\n    bit_A_order.set(false);\n    bit_B_order.set(true);\n    bit_C_order.set(false);\n    bit_D_order.set(false);\n} else if (signal.value == 50){\n    bit_A_order.set(true);\n    bit_B_order.set(true);\n    bit_C_order.set(false);\n    bit_D_order.set(false);\n} else if (signal.value == 60){\n    bit_A_order.set(false);\n    bit_B_order.set(false);\n    bit_C_order.set(true);\n    bit_D_order.set(false);\n} else if (signal.value == 70){\n    bit_A_order.set(true);\n    bit_B_order.set(false);\n    bit_C_order.set(true);\n    bit_D_order.set(false);\n} else if (signal.value == 80){\n    bit_A_order.set(false);\n    bit_B_order.set(true);\n    bit_C_order.set(true);\n    bit_D_order.set(false);\n} else if (signal.value == 90){\n    bit_A_order.set(true);\n    bit_B_order.set(true);\n    bit_C_order.set(true);\n    bit_D_order.set(false);\n} else if (signal.value == 100){\n    bit_A_order.set(false);\n    bit_B_order.set(true);\n    bit_C_order.set(false);\n    bit_D_order.set(true);\n} else if (signal.value == 110){\n    bit_A_order.set(true);\n    bit_B_order.set(true);\n    bit_C_order.set(false);\n    bit_D_order.set(true);\n} else if (signal.value == 120){\n    bit_A_order.set(false);\n    bit_B_order.set(false);\n    bit_C_order.set(true);\n    bit_D_order.set(true);\n} return 1;",
