        "script":"if (start_paging_command.value == ' ') {\n    zone_activated.set(false);\n} else {\n    var data = JSON.parse(start_paging_command.value);\n    var zones = data.zones || [];\n    var messages = data.messages || [];\n\n    print(\"Zonas: \" + zones);\n    print(\"messages: \" + messages);\n\n    var foundIndex = -1;\n\n    for (var i = 0; i < zones.length; i++) {\n        if (zones[i] == 5) {\n            foundIndex = i;\n            break;\n        }\n    }\n\n    if (foundIndex !== -1) {\n        tag_message.set('mensaje ' + messages);\n        message_desc.set(parseInt(messages));\n        message_text.set('mensaje ' + messages);\n        message_id.set(parseInt(messages));\n        zone_activated.set(true);\n    } else {\n        zone_activated.set(false);\n    }\n}\n",
