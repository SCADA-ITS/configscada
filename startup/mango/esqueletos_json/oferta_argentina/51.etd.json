            "updateCronPattern":"0\/15 * * * * ?",
            "script":"var etd = [];\nvar timestamp_aux = new Date().getTime();\n\nfor (ndet = 1; ndet <= 8; ndet++) {\n    if(typeof this['velocidad_media_'+ndet] != 'undefined'){\n        var det = new Object();\n        \n        det.timestamp = timestamp_aux;\n        det.integration_period = this['periodo_integracion_'+ndet].value \/ 60;\n        det.current_direction = this['sentido_circulacion_'+ndet].value;\n        det.n_vehicles = this['intensidad_total_'+ndet].value;\n        det.occupancy = this['ocupacion_espira_cabeza_'+ndet].value;\n        det.congestion = this['deteccion_congestion_'+ndet].value;\n        det.kamikaze = this['deteccion_intensidad_inversa_'+ndet].value;\n        det.average_speed = this['velocidad_media_'+ndet].value;\n        det.average_length = this['longitud_media_'+ndet].value;\n        det.gap = this['distancia_media_'+ndet].value;\n        det.headway = this['distancia_media_'+ndet].value;\n        det.fail_data = this['fallo_datos_'+ndet].value;\n        det.veh_length_1 = this['vehlong1_'+ndet].value;\n        det.veh_length_2 = this['vehlong2_'+ndet].value;\n        det.veh_speed_1 = this['vehvel1_'+ndet].value;\n        det.veh_speed_2 = this['vehvel2_'+ndet].value;\n        det.veh_speed_3 = this['vehvel3_'+ndet].value;\n        \n        etd.push(det);\n    }\n}\n\nvar jsonString = JSON.stringify(etd);\n\nreturn jsonString;",
